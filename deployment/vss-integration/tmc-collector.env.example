# TeraSim Metropolis TMC collector (terasim-tmc-service): connection to NVIDIA Metropolis VSS.
# Docker Compose reads these from the environment; the Helm chart sets them from values
# (shown on the right). Reference: docs/deployment/configuration.md (terasim-tmc-service).

# VSS behavior API (video-analytics API, port 8081). Helm: tmc.vssBehaviorUrl, e.g.
#   http://vss-video-analytics-api.<vss-namespace>.svc:8081
VSS_BEHAVIOR_URL=http://<vss-host>:8081

# Corridor specification: per intersection the road-segment -> heading table (Headings), the
# turn table (Movements) and the approach -> camera table (Assignments). Helm: the chart's
# ConfigMap (configs/Metadata.json or corridorConfig.metadataJson), mounted at /config.
# Generate it from a camera inventory: apps/deploy/city/camera-config/camcfg.py
TMC_SPEC_FILE=/config/Metadata.json

# Registered intersections (and the last counted window), kept across restarts.
TMC_REGISTRY_FILE=/data/tmc/tmc_registry.json

# Seconds a window must have ended before it is counted: behavior objects are written when a
# track ends. Helm: tmc.settleLagS
TMC_SETTLE_LAG_S=180

# Detector labels counted as traffic (comma-separated, case-insensitive, "-" = "_").
# Must match the labels of the VSS detector and the behavior-analytics map-matching classes
# (see labels-and-analytics.md). Helm: tmc.countedObjectTypes
TMC_COUNTED_OBJECT_TYPES=Vehicle,two_wheeler

# Where the snapshots go (terasim-service). Helm: set by the chart.
TERASIM_CITY_URL=http://127.0.0.1:8000

# 1: count every observation window automatically; otherwise only on POST /v1/tmc/run-once.
TMC_AUTOSTART=1

TMC_HOST=0.0.0.0
TMC_PORT=8200
