# .env of the TeraSim deployment directory (README, step 3).
# The CNDE_* and TERASIM_CNDE_IMAGE settings are used in MTR mode only (compose.cnde.yml).
VSS_BEHAVIOR_URL=http://<instance-private-ip>:8081
TMC_SETTLE_LAG_S=180
TERASIM_MCP_PUBLIC_URL=https://<public-vss-host>/terasim
CNDE_MAP_PACKAGE=./cnde_map
TERASIM_CNDE_IMAGE=terasim-metropolis:0.2.0-open-nnde
CNDE_CHECKPOINT=./cnde_assets/nn_weights.pth
CNDE_GPU=0
