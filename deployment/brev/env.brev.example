# .env of the TeraSim deployment directory ~/terasim (README, step 2).
VSS_BEHAVIOR_URL=http://<instance-private-ip>:8081
TMC_SETTLE_LAG_S=180
TERASIM_MCP_PUBLIC_URL=https://<public-vss-host>/terasim
CNDE_MAP_PACKAGE=./cnde_map
TERASIM_CNDE_IMAGE=terasim-metropolis:0.1.0-cnde
CNDE_CHECKPOINT=./cnde_assets/nn_weights.pth
CNDE_GPU=0
