# TeraSim Metropolis with the optional Neural NDE (CNDE) GPU runtime, derived from the
# release image (apps/deploy/city/Dockerfile).
#
# Adds what the "cnde" vehicle behavior needs at run time: PyTorch with CUDA, the runtime's
# Python dependencies and the Neural NDE runtime module (csim, cutils and the cnde model
# package, plus the nuplan-devkit and tuplan-garage source trees its rule controller imports).
# The runtime module is not part of this repository: the build takes it from a second build
# context named "neural-nde" (the directory that holds csim/, cutils/, network/, ...), which
# lands at /app/TeraSim/packages/cnde. The model checkpoint is never baked into the image: it
# is mounted at run time at the fixed path the runtime reads it from,
#   /app/TeraSim/packages/cnde/assets/nn_weights.pth
# and the CNDE map artifacts (cnde_map.pkl, cnde_id_mapping.pkl) travel with the map package
# (the conversion tooling is not installed here).
#
# The runtime module ships CPython 3.10 extension modules (the attention and knn CUDA ops of the
# cnde model package), so this image derives from the Python 3.10 variant of the release image
# (the release image itself runs Python 3.11). Build from the repository root:
#   docker build -f apps/deploy/city/Dockerfile \
#     --build-arg PYTHON_VERSION=3.10 \
#     --build-arg BASE_DIGEST=sha256:2559be987fd64d61badbdafd303ea58a9ccab36d6c3c08bce219e762177d2eca \
#     -t terasim-metropolis:0.1.0-py3.10 .
#   docker build -f apps/deploy/city/Dockerfile.cnde \
#     --build-context neural-nde=<path of the Neural NDE runtime module> \
#     -t terasim-metropolis:0.1.0-cnde .
# The runtime module directory must not hold a checkpoint (*.pth); the build checks it.
#
# PyTorch comes from the cu128 index (CUDA 12.8 wheels, NVIDIA Ada and Blackwell GPUs among
# others) because the torch-cluster wheels the rule controller needs are published for
# torch 2.11.0+cu128. numpy stays at 1.26.4 (the compiled NADE extensions of the base image).
#
# The release image runs as uid 1001 without pip: this file switches to root, restores pip
# with ensurepip for its install steps, removes pip again and ends as uid 1001 like the base
# (the runtime user and the group-0 layout are unchanged).
ARG BASE_IMAGE=terasim-metropolis:0.1.0-py3.10
FROM ${BASE_IMAGE}

USER 0
WORKDIR /app/TeraSim
# Stop before the downloads when the base is not the Python 3.10 variant.
RUN python -c "import sys; v = sys.version_info[:2]; assert v == (3, 10), 'base image runs Python %d.%d; the Neural NDE runtime needs the Python 3.10 variant of the release image (see the header)' % v"
# ensurepip installs pip3 / pip3.10 but no `pip` script, hence `python -m pip` below.
RUN python -m ensurepip --upgrade

RUN python -m pip install --no-cache-dir "numpy==1.26.4" "torch==2.11.0" \
        --index-url https://download.pytorch.org/whl/cu128 \
    && python -m pip install --no-cache-dir "numpy==1.26.4" \
        "torchdiffeq==0.2.5" "igraph==1.0.0" "matplotlib==3.10.8" "tqdm>=4.66" \
        "easydict==1.13" "pyyaml>=6" "scipy==1.15.3" "pyproj==3.7.1" "loguru>=0.7"

RUN python -m pip install --no-cache-dir "numpy==1.26.4" \
        "opencv-python-headless==4.11.0.86" "hydra-core==1.3.2" "omegaconf==2.3.0" \
        "antlr4-python3-runtime==4.9.3" "addict==2.4.0" "dill==0.4.1" "plotly==6.6.0" \
        "texttable==1.7.0" "Cython>=3.0.8"

# Imports the runtime makes lazily (scikit-learn, pykalman, psutil, pytz, pynvml) and
# torch-cluster (PyG wheel for torch 2.11.0+cu128).
RUN python -m pip install --no-cache-dir "numpy==1.26.4" \
        "scikit-learn==1.7.2" "joblib==1.5.3" "threadpoolctl>=3" "pykalman==0.11.2" \
        "scikit-base==0.13.1" "psutil>=7" "pytz" "nvidia-ml-py" \
        "casadi==3.7.2" "control>=0.10" \
    && python -m pip install --no-cache-dir --no-deps "torch-cluster==1.6.3" \
        -f https://data.pyg.org/whl/torch-2.11.0+cu128.html

# The Neural NDE runtime module (second build context "neural-nde").
COPY --from=neural-nde . packages/cnde

ENV PYTHONPATH=/app/TeraSim/packages/cnde/network/cnde:/app/TeraSim/packages/cnde:/app/TeraSim/packages/cnde/nuplan-devkit:/app/TeraSim/packages/cnde/tuplan-garage \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Build-time self check: no checkpoint baked in, the runtime modules of the "cnde" path import
# (CUDA itself is only available at run time), the service's own runtime check reports only the
# checkpoint (mounted at run time) as missing, libsumo is still the active backend. Then the
# caches these root steps left in the runtime user's home go back to uid 1001 / group 0, and pip
# is removed again.
RUN if find packages/cnde -name '*.pth' | grep -q .; then echo 'ERROR: a checkpoint is in the image'; exit 1; fi \
 && python -c "import numpy, torch, torchdiffeq, igraph, matplotlib, yaml, tqdm, scipy, cv2, hydra, omegaconf, sklearn, pykalman, psutil; \
import torch_cluster; \
import csim, cutils; from cnde.models import model as _m; \
import csim.controller.rule_controller; import csim.controller.safety_utils.trajectory_to_region_simple; \
import nuplan.planning.simulation.observation.idm.idm_policy; \
import tuplan_garage.planning.simulation.planner.pdm_planner.utils.pdm_path; \
from terasim_city.envs.cnde_corridor_env import CndeCorridorSignalEnv; \
from terasim_city.factories.cnde_behavior import build_trial_nnde_simulator, missing_cnde_runtime; \
from terasim_city.maps.cnde_artifacts import ensure_cnde_artifacts; \
missing = missing_cnde_runtime(); \
assert len(missing) == 1 and 'checkpoint' in missing[0], missing; \
assert numpy.__version__ == '1.26.4', numpy.__version__; \
print('neural nde runtime imports ok; torch', torch.__version__, '| torch_cluster', torch_cluster.__version__, '| numpy', numpy.__version__)" \
 && python -c "import libsumo; from terasim.overlay import has_libsumo; assert has_libsumo; print('libsumo backend active')" \
 && python -m compileall -q -j 0 packages/cnde \
 && chown -R 1001:0 /home/terasim && chmod -R g+rwX /home/terasim \
 && python -m pip uninstall -y pip \
 && if python -m pip --version >/dev/null 2>&1; then echo 'ERROR: pip still present'; exit 1; fi

USER 1001:0

# The Neural NDE runtime module is not covered by the Apache-2.0 license of this repository.
LABEL org.opencontainers.image.title="terasim-metropolis" \
      org.opencontainers.image.version="0.1.0-cnde" \
      org.opencontainers.image.licenses="NOASSERTION" \
      org.opencontainers.image.description="TeraSim Metropolis with the optional Neural NDE (CNDE) GPU runtime; mount the model checkpoint at /app/TeraSim/packages/cnde/assets/nn_weights.pth"
